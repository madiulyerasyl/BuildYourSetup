@startuml
title Build Your Setup - UML Class Diagram

skinparam backgroundColor #FFFFFF
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
left to right direction

package "Model" {
    abstract class Component
    class CPU
    class GPU
    class RAM
    class PCBuild
}

Component <|-- CPU
Component <|-- GPU
Component <|-- RAM

PCBuild o-- CPU
PCBuild o-- GPU
PCBuild o-- RAM

package "Builder Pattern" {
    class PCBuildBuilder
}
PCBuildBuilder --> PCBuild : builds

package "Factory Method Pattern" {
    abstract class ComponentFactory
    class CPUFactory
    class GPUFactory
    class RAMFactory
}
ComponentFactory <|-- CPUFactory
ComponentFactory <|-- GPUFactory
ComponentFactory <|-- RAMFactory

package "Strategy Pattern" {
    interface BuildStrategy
    class BudgetStrategy
    class PerformanceStrategy
}
BuildStrategy <|.. BudgetStrategy
BuildStrategy <|.. PerformanceStrategy

package "Observer Pattern" {
    interface BuildObserver
    class PCBuildManager
    class PriceObserver
    class NotificationObserver
}
BuildObserver <|.. PriceObserver
BuildObserver <|.. NotificationObserver
PCBuildManager o-- BuildObserver : notifies
PCBuildManager --> PCBuild : manages

package "Decorator Pattern" {
    interface BuildOption
    class BasicBuild
    abstract class BuildDecorator
    class RGBDecorator
    class WarrantyDecorator
}
BuildOption <|.. BasicBuild
BuildOption <|.. BuildDecorator
BuildDecorator <|-- RGBDecorator
BuildDecorator <|-- WarrantyDecorator
BuildDecorator o-- BuildOption : wraps
BasicBuild --> PCBuild

package "Adapter Pattern" {
    interface ComponentCatalog
    class ExternalCatalogAdapter
}
ComponentCatalog <|.. ExternalCatalogAdapter

package "Facade Pattern" {
    class PCValidationFacade
    class ValidationResult
}
PCValidationFacade --> ValidationResult : returns
PCValidationFacade --> PCBuild : validates

package "Visitor Pattern" {
    interface ComponentVisitor
    class ReportVisitor
    class PriceSummaryVisitor
}
ComponentVisitor <|.. ReportVisitor
ComponentVisitor <|.. PriceSummaryVisitor
Component ..> ComponentVisitor : accept()

package "Persistence" {
    class BuildStorage
    class SavedBuild
}
BuildStorage --> SavedBuild : stores

class MainApp
MainApp --> PCBuildManager
MainApp --> PCValidationFacade
MainApp --> BuildStorage
MainApp --> ReportVisitor

@enduml
